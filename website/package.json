{
  "name": "logicspace-website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/postbuild-check.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format:check": "prettier --check src scripts index.html package.json vite.config.ts tsconfig.json README.md",
    "format": "prettier --write src scripts index.html package.json vite.config.ts tsconfig.json README.md"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
